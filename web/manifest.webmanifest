{
  "id": "./",
  "name": "CINARO — سينارو",
  "short_name": "CINARO",
  "description": "تجربة سينمائية عربية للأفلام والمسلسلات مع حساب ومزامنة آمنة عبر Firebase.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#08090d",
  "theme_color": "#08090d",
  "categories": ["entertainment", "video"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "الأفلام",
      "short_name": "الأفلام",
      "url": "./#movies",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "المسلسلات",
      "short_name": "المسلسلات",
      "url": "./#series",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "قائمتي",
      "short_name": "قائمتي",
      "url": "./#library",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
