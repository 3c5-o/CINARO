rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function activeUser() {
      return signedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'blocked'
      );
    }

    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "ffkyyr@gmail.com"
      );
    }

    function currentAssignment() {
      return get(/databases/$(database)/documents/supervisorAssignments/$(request.auth.uid));
    }

    function supervisor() {
      return signedIn()
        && currentAssignment().data.active == true
        && currentAssignment().data.sectionIds is list;
    }

    function supervisorCanCreate() {
      return supervisor()
        && currentAssignment().data.permissions is map
        && currentAssignment().data.permissions.createContent == true;
    }

    function supervisorCanEdit() {
      return supervisor()
        && currentAssignment().data.permissions is map
        && currentAssignment().data.permissions.editContent == true;
    }

    function supervisorCanDelete() {
      return supervisor()
        && currentAssignment().data.permissions is map
        && currentAssignment().data.permissions.deleteContent == true;
    }

    function supervisorCanPublish() {
      return supervisor()
        && currentAssignment().data.permissions is map
        && currentAssignment().data.permissions.publishContent == true;
    }

    function assignedContent(data) {
      return supervisor()
        && data.sectionIds is list
        && data.sectionIds.size() > 0
        && data.sectionIds.hasOnly(currentAssignment().data.sectionIds);
    }

    function supervisorCanCreateContent(contentId, data) {
      return supervisorCanCreate()
        && assignedContent(data)
        && data.id is string
        && data.id == contentId
        && data.updatedBy == request.auth.uid
        && data.views is int
        && data.views == 0
        && (
          data.get('published', false) == false ||
          supervisorCanPublish()
        );
    }

    function supervisorCanUpdateContent(contentId) {
      return supervisorCanEdit()
        && assignedContent(resource.data)
        && assignedContent(request.resource.data)
        && request.resource.data.id is string
        && request.resource.data.id == contentId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.get('views', 0) == resource.data.get('views', 0)
        && (
          request.resource.data.published == resource.data.published ||
          supervisorCanPublish()
        );
    }

    function uniqueViewIncrement(contentId) {
      return activeUser()
        && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is int
        && request.resource.data.views == resource.data.views + 1
        && !exists(/databases/$(database)/documents/content/$(contentId)/viewers/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/content/$(contentId)/viewers/$(request.auth.uid));
    }

    match /content/{contentId} {
      allow get, list: if resource.data.published == true || admin() || supervisor();

      allow create: if admin() || supervisorCanCreateContent(contentId, request.resource.data);

      allow update: if admin()
        || supervisorCanUpdateContent(contentId)
        || uniqueViewIncrement(contentId);

      allow delete: if admin() || (
        supervisorCanDelete() && assignedContent(resource.data)
      );

      match /viewers/{userId} {
        allow get: if owner(userId) || admin();
        allow list: if admin();
        allow create: if owner(userId)
          && activeUser()
          && request.resource.data.keys().hasOnly(['userId', 'contentId', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.contentId == contentId;
        allow update, delete: if false;
      }
    }

    match /appConfig/public {
      allow read: if true;
      allow write: if admin();
    }

    match /users/{userId} {
      allow read: if owner(userId) || admin();

      allow create: if owner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'isAnonymous', 'createdAt', 'updatedAt'
        ]);

      allow update: if admin() || (
        owner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'isAnonymous', 'updatedAt'
        ])
      );

      allow delete: if owner(userId) || admin();

      match /private/{documentId} {
        allow read: if owner(userId) || admin();
        allow write: if admin() || (owner(userId) && activeUser());
      }
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if admin();
    }

    match /supervisorAssignments/{uid} {
      allow read: if admin() || owner(uid);
      allow write: if admin();
    }

    match /auditLogs/{logId} {
      allow read: if admin();
      allow create: if admin() || (
        supervisor()
        && request.resource.data.actorUid == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow get, list: if resource.data.published == true || admin();
      allow create, update, delete: if admin();
    }

    match /contentRequests/{requestId} {
      allow create: if activeUser()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'title', 'kind', 'notes',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId is string
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.userEmail.size() <= 180
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 180
        && request.resource.data.kind in ['movie', 'series']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 600
        && request.resource.data.status == 'new';

      allow read: if admin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );

      allow update, delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'contentId', 'contentTitle', 'kind',
          'season', 'episode', 'category', 'details', 'sourceUrl',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId is string
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 180
        && request.resource.data.contentId is string
        && request.resource.data.contentId.size() > 0
        && request.resource.data.contentId.size() <= 120
        && request.resource.data.contentTitle is string
        && request.resource.data.contentTitle.size() > 0
        && request.resource.data.contentTitle.size() <= 180
        && request.resource.data.kind in ['movie', 'series']
        && request.resource.data.season is int
        && request.resource.data.season >= 0
        && request.resource.data.season <= 1000
        && request.resource.data.episode is int
        && request.resource.data.episode >= 0
        && request.resource.data.episode <= 10000
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 600
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 2048
        && request.resource.data.status == 'open';
      allow read, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
